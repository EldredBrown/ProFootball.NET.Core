@if (Model.TeamSeasonScheduleProfile != null)
{
    <h5>Team Season Schedule Profile</h5>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().Opponent"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().GamePointsFor"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().GamePointsAgainst"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentWins"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentLosses"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentTies"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentWinningPercentage"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentWeightedGames"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentWeightedPointsFor"></label>
                </th>
                <th class="text-right">
                    <label asp-for="TeamSeasonScheduleProfile.SingleOrDefault().OpponentWeightedPointsAgainst"></label>
                </th>
            </tr>
        </thead>
        <tbody>
    @foreach (var opponentProfile in Model.TeamSeasonScheduleProfile)
    {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => opponentProfile.Opponent)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.GamePointsFor)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.GamePointsAgainst)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentWins)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentLosses)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentTies)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentWinningPercentage)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentWeightedGames)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentWeightedPointsFor)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => opponentProfile.OpponentWeightedPointsAgainst)
                </td>
            </tr>
    }
        </tbody>
    </table>
}

