@using EldredBrown.ProFootball.AspNetCore.MvcWebApp.ViewModels.TeamSeason
@model TeamSeasonIndexViewModel

@{
    ViewData["Title"] = "Team Seasons";
}

<h1>@ViewData["Title"]</h1>

<form>
    <div class="form-group">
        <label class="col-form-label">Season</label>
        <select onchange="document.location.href=`/TeamSeason/SetSelectedSeasonYear?SeasonYear=${this.options[this.selectedIndex].value}`;"
                asp-for="SelectedSeasonYear" asp-items="Model.Seasons">
        </select >
    </div>
    <p>
        <a class="btn btn-primary btn-lg" asp-action="RunWeeklyUpdate">Run Weekly Update</a>
    </p>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().TeamName"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().Wins"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().Losses"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().Ties"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().WinningPercentage"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().PointsFor"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().PointsAgainst"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().ExpectedWins"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().ExpectedLosses"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().OffensiveAverage"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().OffensiveFactor"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().OffensiveIndex"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().DefensiveAverage"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().DefensiveFactor"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().DefensiveIndex"></label>
            </th>
            <th>
                <label asp-for="TeamSeasons.SingleOrDefault().FinalExpectedWinningPercentage"></label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var teamSeason in Model.TeamSeasons)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => teamSeason.TeamName)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.Wins)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.Losses)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.Ties)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.WinningPercentage)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.PointsFor)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.PointsAgainst)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.ExpectedWins)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.ExpectedLosses)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.OffensiveAverage)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.OffensiveFactor)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.OffensiveIndex)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.DefensiveAverage)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.DefensiveFactor)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.DefensiveIndex)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => teamSeason.FinalExpectedWinningPercentage)
            </td>
            <td>
                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@teamSeason.Id">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
