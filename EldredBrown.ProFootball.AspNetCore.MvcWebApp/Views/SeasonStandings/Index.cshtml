@using EldredBrown.ProFootball.AspNetCore.MvcWebApp.ViewModels.SeasonStandings
@model SeasonStandingsIndexViewModel

@{
    ViewData["Title"] = "Season Standings";
}

<h1>@ViewData["Title"]</h1>

<form>
    <div class="form-group">
        <label class="col-form-label">Season</label>
        <select onchange="document.location.href=`/SeasonStandings/SetSelectedSeasonYear?SeasonYear=${this.options[this.selectedIndex].value}`;"
                asp-for="SelectedSeasonYear" asp-items="Model.Seasons">
        </select>
    </div>
    <div class="form-group">
        <label class="col-form-label">League</label>
        <select onchange="document.location.href=`/SeasonStandings/SetSelectedLeagueName?LeagueName=${this.options[this.selectedIndex].value}`;"
                asp-for="SelectedLeagueName" asp-items="Model.Leagues">
        </select>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                <label asp-for="SeasonStandings.SingleOrDefault().Team"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().Wins"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().Losses"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().Ties"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().WinningPercentage"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().PointsFor"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().PointsAgainst"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().AvgPointsFor"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().AvgPointsAgainst"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().ExpectedWins"></label>
            </th>
            <th class="text-right">
                <label asp-for="SeasonStandings.SingleOrDefault().ExpectedLosses"></label>
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.SeasonStandings)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Team)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.Wins)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.Losses)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.Ties)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.WinningPercentage)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.PointsFor)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.PointsAgainst)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.AvgPointsFor)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.AvgPointsAgainst)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.ExpectedWins)
            </td>
            <td class="text-right">
                @Html.DisplayFor(modelItem => item.ExpectedLosses)
            </td>
        </tr>
}
    </tbody>
</table>
