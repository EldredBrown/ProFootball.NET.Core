@using EldredBrown.ProFootball.AspNetCore.MvcWebApp.ViewModels.Season
@model SeasonIndexViewModel

@{
    ViewData["Title"] = "Seasons";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th class="text-right">
                <label asp-for="Seasons.SingleOrDefault().Year"></label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var season in Model.Seasons) {
        <tr>
            <td class="text-right">
                @Html.DisplayFor(modelItem => season.Year)
            </td>
            <td>
                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-year="@season.Year">Details</a>
                <a class="btn btn-primary btn-sm" asp-action="Delete" asp-route-year="@season.Year">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
